# Copy to .env and fill in. Never commit the real .env (see .gitignore).

# --- object detection ---
GROUNDING_DINO_CONFIG_PATH=weights/GroundingDINO_SwinT_OGC.py
GROUNDING_DINO_WEIGHTS_PATH=weights/groundingdino_swint_ogc.pth
DETECTION_BOX_THRESHOLD=0.35
DETECTION_TEXT_THRESHOLD=0.25
DETECTION_LOW_CONFIDENCE_CUTOFF=0.45

# --- scene classification ---
CLIP_MODEL_NAME=ViT-B/32

# --- LLM reasoning ---
OLLAMA_HOST=http://localhost:11434
LLM_MODEL_NAME=phi4-mini
LLM_TEMPERATURE=0.2
LLM_MAX_RETRIES=2
LLM_MAX_ITEMS_PER_CALL=10

# --- Reorganise planner bounds (research path only) ---
# Production does NOT call the Reorganise LLM planner — Direct Reorganise
# and Both build the deterministic plan directly. These bound the
# retained research path and the evaluation harness only, and apply to
# app/models/reorganise_llm.py alone; Declutter's own LLM behaviour is
# deliberately unchanged. Both must be positive; the timeout must be
# finite, and num_predict must be a whole number.
REORGANISE_LLM_TIMEOUT_S=210.0
REORGANISE_LLM_NUM_PREDICT=1536

# --- marketplace listing drafts (V1 generation bounds) ---
# Bound app/models/listing_llm.py's single per-item call and
# app/services/listing_service.py's per-item retry budget only. Timeout
# must be finite and positive; num_predict a positive whole number;
# max_attempts a whole number 1..5.
LISTING_LLM_TIMEOUT_S=60.0
LISTING_LLM_NUM_PREDICT=512
LISTING_LLM_MAX_ATTEMPTS=3
# PROVISIONAL: the model name and temperature for listing writing are
# their own knobs, not shared with Declutter. The defaults below only
# mirror the Declutter values for local convenience while listing
# generation is unevaluated — that is not evidence they suit listing
# writing. Model name: any non-blank string (a locally installed model).
# Temperature: a finite number in [0.0, 2.0].
LISTING_LLM_MODEL_NAME=phi4-mini
LISTING_LLM_TEMPERATURE=0.2

# --- speech-to-text ---
# Backend must be "faster-whisper" (default — chosen for load time, with
# accuracy measured identical to whisper, not better) or "whisper" (still
# fully supported; set that value to switch back). Both ship in
# requirements.txt.
# Model size must be exactly "base" — the only size this project
# evaluates or ships. Any other value, path or padded string is a startup
# failure, so configuration can never name an arbitrary checkpoint.
WHISPER_MODEL_SIZE=base
STT_BACKEND=faster-whisper
# Positive whole numbers. These two bound transcription work; there is
# deliberately NO transcription timeout — a timeout around a worker
# thread cannot stop CPU-bound inference, so it would promise a
# cancellation that never happens.
STT_MAX_UPLOAD_BYTES=10485760
STT_MAX_AUDIO_SECONDS=60
# CTranslate2 quantisation, faster-whisper only; ignored by openai-whisper.
STT_COMPUTE_TYPE=int8
# MUST be true — this is validated, not merely defaulted. A false value
# fails startup, because a user request must never trigger a model
# download. Fetching weights deliberately is a separate, explicitly
# approved evaluation step that calls the model wrapper directly.
STT_LOCAL_FILES_ONLY=true

# --- image generation: remote Colab/ngrok service (§5) ---
# Use a reserved/static ngrok domain, not the free rotating kind — see
# app/models/image_gen_client.py for why. Start the Colab notebook before
# running anything that touches /generate.
IMAGE_GEN_BASE_URL=https://REPLACE-ME.ngrok-free.app
IMAGE_GEN_HEALTH_TIMEOUT_S=3.0
IMAGE_GEN_REQUEST_TIMEOUT_S=180.0
IMAGE_GEN_DENOISE_STRENGTH=0.35
# Provisional standard baseline, not an evidence-backed optimum — R7 must
# verify or revise once a real Colab checkpoint/pipeline exists.
IMAGE_GEN_CONTROLNET_CONDITIONING_SCALE=1.0
# Fixed default for reproducible demo/evaluation runs; overridable per call.
IMAGE_GEN_SEED=42

# --- logging ---
LOG_DIR=logs
LOG_LEVEL=INFO

# --- CORS ---
FRONTEND_ORIGIN=http://localhost:5173
